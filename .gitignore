# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build
/dist

# misc
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# editors / local tooling
.idea/
.vscode/
.cursor/
*.local

# generated scrape dumps
/src/data/wiki/enemy-reference.json

# oversized map sources — GitHub warns at 50MB and rejects files over 100MB
/public/assets/map/T_UI_Map_Full_NoFog.png
/public/assets/map/T_UI_Map_Full_Fog.png
/public/assets/map/T_UI_MapGlobalMask.png
